# Exora configuration. `prospector init` copies this file to .env and fills in a random secret.
# Every variable is optional except the secret when the app is reachable from other machines.
# NEVER commit the filled-in .env (it is gitignored); rotate the secret if it leaks.

# --- session signing (32+ characters). Generate one: python -c "import secrets; print(secrets.token_hex(32))"
#     Docker: leave empty and the container generates one on its data volume.
PROSPECTOR_SECRET_KEY=

# --- your organisation and clock
# Shown under the product name in the sidebar and on the sign-in page (empty = hidden).
PROSPECTOR_ORG_NAME=
# IANA timezone for "today", plan weeks and every timestamp in the UI, e.g. Europe/London, America/New_York.
PROSPECTOR_OPERATOR_TIMEZONE=UTC

# --- polite discovery: who you are when reading public sources. Strongly recommended.
# Appended to the crawler User-Agent and used for SEC EDGAR, which requires a contact address.
#PROSPECTOR_CONTACT_EMAIL=research@your-company.com
#PROSPECTOR_USER_AGENT=YourCompany-Research/1.0 (+https://your-company.com; research@your-company.com)
#PROSPECTOR_SEC_USER_AGENT=YourCompany Research (research@your-company.com)

# --- database. Default: SQLite file under data/. Postgres needs `uv sync --extra postgres`.
#PROSPECTOR_DATABASE_URL=sqlite:///data/prospector.db
#PROSPECTOR_DATABASE_URL=postgresql+psycopg://exora:PASSWORD@localhost:5432/exora

# --- plan, docs and seed sheet (paths relative to PROSPECTOR_DOCS_ROOT, default: the repository root)
#PROSPECTOR_DOCS_ROOT=.
#PROSPECTOR_PLAN_MD=playbook/PLAN.md
#PROSPECTOR_SEED_CSV=playbook/accounts.example.csv

# --- optional discovery keys
# Free key: https://developer.company-information.service.gov.uk (UK Companies House source)
#PROSPECTOR_COMPANIES_HOUSE_KEY=
# Raises the GitHub API limit from 60 to 5,000 requests/hour (no scopes needed)
#PROSPECTOR_GITHUB_TOKEN=
# Your own or a paid Overpass server, tried before the busy public ones (comma-separated)
#PROSPECTOR_OVERPASS_URL=https://overpass.your-company.com/api/interpreter

# --- email checks: SMTP mailbox probing. Off unless set to 1; most hosts and ISPs block outbound port 25.
#PROSPECTOR_SMTP_PROBE=1
# MAIL FROM for probes: an address you own, or leave unset for the null sender <>
#PROSPECTOR_PROBE_FROM=probe@your-company.com
#PROSPECTOR_PROBE_TTL_HOURS=24

# --- deployment shape
# true  = workers + scheduler inside the web process (one machine, simplest)
# false = run `prospector worker` separately (Docker: the `worker` profile)
#PROSPECTOR_WORKER_ENABLED=true
#PROSPECTOR_SCHEDULER_ENABLED=true
#PROSPECTOR_WORKER_THREADS=2
# Queue a website crawl for every new company that has a website.
#PROSPECTOR_AUTO_ENRICH=true
# Windows laptops: keep the machine awake while the data engine runs.
#PROSPECTOR_KEEP_AWAKE=true

# --- serving over HTTPS / behind a proxy
# true when users reach the app over HTTPS (Coolify, Caddy, Cloudflare Tunnel): cookies become HTTPS-only.
#PROSPECTOR_COOKIE_SECURE=false
# true only when a reverse proxy is the sole route in (honours X-Forwarded-* / CF-Connecting-IP).
#PROSPECTOR_TRUST_PROXY=false
# JSON list of hostnames to answer, e.g. ["exora.your-company.com"]. Empty list = any host.
#PROSPECTOR_ALLOWED_HOSTS=[]
#PROSPECTOR_SESSION_HOURS=12

# --- observability
#PROSPECTOR_METRICS_ENABLED=false
#PROSPECTOR_METRICS_TOKEN=
#PROSPECTOR_API_DOCS_PUBLIC=false
#PROSPECTOR_LOG_DIR=data/logs
#PROSPECTOR_EXPORT_MAX_ROWS=50000

# --- optional outreach engine (separate package; see docs/DEPLOYMENT.md). Off until configured.
#PROSPECTOR_ENGINE_ENABLED=false
#PROSPECTOR_ENGINE_CONFIG=/path/to/outreach-engine/config.yaml

# --- Docker compose only
#EXORA_BIND=127.0.0.1
#EXORA_PORT=8090
#CF_TUNNEL_TOKEN=
